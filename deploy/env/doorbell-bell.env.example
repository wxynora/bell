BELL_STREAM_URL=https://doorbellcommons.com/api/bell/stream
BELL_ACK_URL=https://doorbellcommons.com/api/bell/ack
BELL_REPORT_URL=https://doorbellcommons.com/api/bell/report
BELL_TOKEN=replace-with-one-db-bell-credential

BELL_STATE_DIRECTORY=/var/lib/doorbell-bell
BELL_INJECTOR_EXECUTABLE=/root/du-gateway/.venv/bin/python
BELL_INJECTOR_ARGS_JSON=["/root/du-gateway/scripts/doorbell_bell_injector.py"]
BELL_INJECTOR_WORKING_DIRECTORY=/root/du-gateway
BELL_LOG_LEVEL=info

BELL_CONNECT_TIMEOUT_MS=10000
BELL_STREAM_IDLE_TIMEOUT_MS=90000
BELL_HTTP_TIMEOUT_MS=10000
BELL_HTTP_MAX_ATTEMPTS=3
BELL_HTTP_RETRY_DELAY_MS=1000
BELL_RECONNECT_INITIAL_MS=1000
BELL_RECONNECT_MAX_MS=30000
BELL_RECONNECT_MAX_ATTEMPTS=20
BELL_RECONNECT_JITTER_RATIO=0.2
BELL_INJECTOR_TIMEOUT_MS=300000
BELL_INJECTOR_KILL_GRACE_MS=5000
BELL_INJECTOR_MAX_ATTEMPTS=3
BELL_INJECTOR_RETRY_DELAY_MS=30000
BELL_BUSY_RETRY_DELAY_MS=30000
BELL_BUSY_MAX_ATTEMPTS=10
BELL_MAX_PENDING_WAKES=32
BELL_SQLITE_BUSY_TIMEOUT_MS=5000
BELL_ACCEPTED_RETENTION_DAYS=180
BELL_MAX_EVENT_BYTES=65536
BELL_MAX_WAKE_ID_CHARS=128
BELL_MAX_REASON_CHARS=64
BELL_MAX_MESSAGE_CHARS=512
BELL_MAX_TIMESTAMP_CHARS=64
BELL_MAX_EPOCH_CHARS=128
BELL_MAX_ERROR_CODE_CHARS=64
BELL_MAX_INJECTOR_OUTPUT_BYTES=4096
