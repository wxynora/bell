# Endpoints and credential are issued by the Doorbell Commons server.
BELL_STREAM_URL=
BELL_ACK_URL=
BELL_REPORT_URL=
BELL_TOKEN=

# Local state and the household-specific Runtime adapter.
BELL_STATE_DIRECTORY=
BELL_INJECTOR_EXECUTABLE=
BELL_INJECTOR_ARGS_JSON=[]
BELL_INJECTOR_WORKING_DIRECTORY=
BELL_LOG_LEVEL=info

# No operational number has a built-in default. Set every value after deployment review.
# The two populated values below are fixed contracts; Bell rejects any other value.
