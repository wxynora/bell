BELL_RECONNECT_MAX_ATTEMPTS=
BELL_RECONNECT_JITTER_RATIO=
BELL_INJECTOR_TIMEOUT_MS=
BELL_INJECTOR_KILL_GRACE_MS=
BELL_INJECTOR_MAX_ATTEMPTS=
BELL_INJECTOR_RETRY_DELAY_MS=
BELL_BUSY_RETRY_DELAY_MS=
BELL_BUSY_MAX_ATTEMPTS=
BELL_MAX_PENDING_WAKES=32
BELL_SQLITE_BUSY_TIMEOUT_MS=
BELL_ACCEPTED_RETENTION_DAYS=180
BELL_MAX_EVENT_BYTES=
